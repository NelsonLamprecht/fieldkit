<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only, whatever feeds are configured on the machine, so every build restores the same way -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
